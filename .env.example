# Supabase Configuration (Database & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Groq Cloud AI Concierge ("Aanya")
GROQ_API_KEY=gsk_your_groq_api_key

# Upstash Redis (Distributed Rate Limiting & Bot Protection)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Razorpay Payment Gateway (https://dashboard.razorpay.com)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Logistics: BVC Logistics eSHIP (Armored Jewelry Courier)
BVC_API_KEY=your_bvc_api_key
BVC_API_SECRET=your_bvc_api_secret
BVC_APP_ID=your_bvc_app_id
BVC_ORIGIN_PINCODE=180013
BVC_WEBHOOK_SECRET=your_bvc_webhook_secret

# Logistics: Shiprocket (Secondary / Accessories)
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_LOCATION=Primary

# Daily Bullion Rates (https://www.goldapi.io)
GOLDAPI_KEY=your_goldapi_key

# Admin Counter Protection
ADMIN_PASSCODE=your_admin_passcode
ADMIN_SESSION_SECRET=minimum_16_characters_random_hex_secret

# Security & PII Encryption (PAN & phone data encryption at rest)
ENCRYPTION_SECRET=minimum_32_characters_random_hex_key_for_pan_encryption

# Transactional Emails (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Ambika Jewels <orders@ambikajewelsonline.com>

# Statutory Seller KYC Configuration (Consumer Protection E-Commerce Rules)
STORE_LEGAL_NAME=Ambika Jewels
STORE_ENTITY_TYPE=Sole Proprietorship
STORE_GSTIN=01AHWPH9511N1ZX
STORE_PAN=AHWPH9511N
